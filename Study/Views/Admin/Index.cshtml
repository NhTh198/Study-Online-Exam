@{
    ViewData["Title"] = "Admin Dashboard";
}
<style>
    .admin-home{min-height:calc(100vh - 150px);padding:48px 5%;background:#f8fafc}
    .admin-wrap{max-width:1150px;margin:0 auto}
    .admin-title{margin:0;color:#1d4ed8;font-size:34px;font-weight:800}
    .admin-subtitle{margin:10px 0 30px;color:#64748b}
    .admin-grid{display:grid;grid-template-columns:repeat(2,minmax(0,1fr));gap:22px}
    .admin-card{display:block;background:#fff;border:1px solid #e2e8f0;border-radius:16px;padding:28px;text-decoration:none;box-shadow:0 4px 15px rgba(15,23,42,.05);transition:.2s}
    .admin-card:hover{transform:translateY(-3px);border-color:#93c5fd;box-shadow:0 10px 24px rgba(37,99,235,.10)}
    .admin-icon{font-size:34px;margin-bottom:15px}
    .admin-card h2{font-size:21px;color:#0f172a;margin:0 0 8px}
    .admin-card p{color:#64748b;margin:0;line-height:1.6}
    .admin-link{display:inline-block;margin-top:18px;color:#2563eb;font-weight:700}
    @@media(max-width:700px){.admin-grid{grid-template-columns:1fr}.admin-title{font-size:28px}}
</style>
<div class="admin-home">
 <div class="admin-wrap">
  <h1 class="admin-title">ADMIN DASHBOARD</h1>
  <p class="admin-subtitle">Khu vực quản lý môn học và phân công môn học cho giảng viên.</p>
  <div class="admin-grid">
   <a class="admin-card" asp-controller="Admin" asp-action="Subject">
    <div class="admin-icon">📚</div>
    <h2>Quản lý môn học</h2>
    <p>Thêm, xem, chỉnh sửa, khóa/mở khóa và xóa môn học theo điều kiện nghiệp vụ.</p>
    <span class="admin-link">Mở chức năng →</span>
   </a>
   <a class="admin-card" asp-controller="Admin" asp-action="Lecturers">
    <div class="admin-icon">👩‍🏫</div>
    <h2>Phân công môn học</h2>
    <p>Chọn giảng viên, phân công môn học đang hoạt động và theo dõi danh sách phân công.</p>
    <span class="admin-link">Mở chức năng →</span>
   </a>
  </div>
 </div>
</div>
