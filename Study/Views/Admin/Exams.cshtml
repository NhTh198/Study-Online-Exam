@model List<Study.ViewModels.AdminReviewExamViewModel>

@{
    ViewData["Title"] = "Quản lý kỳ thi";
}

<style>
    .exam-page {
        width: 100%;
        min-height: calc(100vh - 150px);
        padding: 40px 5%;
        background: #f8fafc;
        box-sizing: border-box;
    }

    .page-header {
        margin-bottom: 25px;
    }

        .page-header h1 {
            margin: 0;
            color: #0f172a;
            font-size: 30px;
        }

        .page-header p {
            margin-top: 8px;
            color: #64748b;
        }

    .alert {
        padding: 14px 18px;
        border-radius: 10px;
        margin-bottom: 20px;
        font-weight: 500;
    }

    .alert-success {
        background: #dcfce7;
        color: #166534;
    }

    .alert-error {
        background: #fee2e2;
        color: #991b1b;
    }

    .table-card {
        background: white;
        border-radius: 16px;
        overflow: hidden;
        box-shadow: 0 4px 15px rgba(15, 23, 42, 0.06);
    }

    .table-wrapper {
        width: 100%;
        overflow-x: auto;
    }

    table {
        width: 100%;
        min-width: 1050px;
        border-collapse: collapse;
    }

    th {
        background: #eff6ff;
        color: #1e3a8a;
        padding: 16px;
        text-align: left;
        font-size: 14px;
        white-space: nowrap;
    }

    td {
        padding: 16px;
        border-top: 1px solid #e2e8f0;
        color: #334155;
        vertical-align: middle;
    }

    tr:hover {
        background: #f8fafc;
    }

    .exam-name {
        font-weight: 600;
        color: #0f172a;
    }

    .subject-code {
        display: inline-block;
        padding: 5px 9px;
        background: #dbeafe;
        color: #1d4ed8;
        border-radius: 6px;
        font-size: 12px;
        font-weight: 700;
    }

    .status {
        display: inline-block;
        padding: 6px 10px;
        border-radius: 20px;
        font-size: 12px;
        font-weight: 600;
        white-space: nowrap;
    }

    .status-draft {
        background: #e2e8f0;
        color: #475569;
    }

    .status-pending {
        background: #fef3c7;
        color: #92400e;
    }

    .status-rejected {
        background: #fee2e2;
        color: #991b1b;
    }

    .status-approved {
        background: #dcfce7;
        color: #166534;
    }

    .status-scheduled {
        background: #ede9fe;
        color: #6d28d9;
    }

    .status-published {
        background: #dbeafe;
        color: #1d4ed8;
    }

    .status-finished {
        background: #e2e8f0;
        color: #334155;
    }

    .actions {
        display: flex;
        gap: 7px;
        flex-wrap: wrap;
    }

    .action-btn {
        border: none;
        border-radius: 7px;
        padding: 8px 11px;
        font-size: 13px;
        font-weight: 600;
        cursor: pointer;
        text-decoration: none;
        display: inline-block;
    }

    .btn-view {
        background: #dbeafe;
        color: #1d4ed8;
    }

    .btn-approve {
        background: #dcfce7;
        color: #166534;
    }

    .btn-reject {
        background: #fee2e2;
        color: #b91c1c;
    }

    .empty {
        padding: 60px 20px;
        text-align: center;
        color: #64748b;
    }

    @@media (max-width: 700px) {
        .exam-page {
            padding: 25px 15px;
        }
    }
</style>

<div class="exam-page">

    <div class="page-header">
        <h1>Quản lý kỳ thi</h1>

        <p>
            Admin xem và duyệt các kỳ thi do Lecturer gửi lên.
        </p>
    </div>


    @if (TempData["Success"] != null)
    {
        <div class="alert alert-success">
            @TempData["Success"]
        </div>
    }

    @if (TempData["Error"] != null)
    {
        <div class="alert alert-error">
            @TempData["Error"]
        </div>
    }


    <div class="table-card">

        @if (Model == null || !Model.Any())
        {
            <div class="empty">

                <h3>Chưa có kỳ thi</h3>

                <p>
                    Hiện chưa có kỳ thi nào trong hệ thống.
                </p>

            </div>
        }
        else
        {
            <div class="table-wrapper">

                <table>

                    <thead>
                        <tr>
                            <th>ID</th>
                            <th>Kỳ thi</th>
                            <th>Môn</th>
                            <th>Lecturer</th>
                            <th>Số câu</th>
                            <th>Trạng thái</th>
                            <th>Ngày tạo</th>
                            <th>Thao tác</th>
                        </tr>
                    </thead>

                    <tbody>

                        @foreach (var exam in Model)
                        {
                            <tr>

                                <td>
                                    @exam.Id
                                </td>

                                <td>
                                    <span class="exam-name">
                                        @exam.Name
                                    </span>
                                </td>

                                <td>
                                    <span class="subject-code">
                                        @exam.SubjectCode
                                    </span>

                                    <br />

                                    @exam.SubjectName
                                </td>

                                <td>
                                    @exam.LecturerName
                                </td>

                                <td>
                                    @exam.QuestionCount
                                </td>

                                <td>

                                    @switch (exam.Status)
                                    {
                                        case "Draft":
                                            <span class="status status-draft">
                                                Nháp
                                            </span>
                                            break;

                                        case "PendingApproval":
                                            <span class="status status-pending">
                                                Chờ duyệt
                                            </span>
                                            break;

                                        case "Rejected":
                                            <span class="status status-rejected">
                                                Từ chối
                                            </span>
                                            break;

                                        case "Approved":
                                            <span class="status status-approved">
                                                Đã duyệt
                                            </span>
                                            break;

                                        case "Scheduled":
                                            <span class="status status-scheduled">
                                                Đã xếp lịch
                                            </span>
                                            break;

                                        case "Published":
                                            <span class="status status-published">
                                                Đã công bố
                                            </span>
                                            break;

                                        case "Finished":
                                            <span class="status status-finished">
                                                Đã kết thúc
                                            </span>
                                            break;

                                        default:
                                            <span class="status status-draft">
                                                @exam.Status
                                            </span>
                                            break;
                                    }

                                </td>

                                <td>
                                    @exam.CreatedAt.ToString("dd/MM/yyyy HH:mm")
                                </td>

                                <td>

                                    <div class="actions">

                                        <!-- Xem chi tiết -->
                                        <a asp-controller="Admin"
                                           asp-action="ReviewExam"
                                           asp-route-id="@exam.Id"
                                           class="action-btn btn-view">
                                            Xem
                                        </a>


                                        <!-- Đề đang chờ duyệt -->
                                        @if (exam.Status == "PendingApproval")
                                        {
                                            <form asp-controller="Admin"
                                                  asp-action="ApproveExam"
                                                  asp-route-id="@exam.Id"
                                                  method="post">

                                                @Html.AntiForgeryToken()

                                                <button type="submit"
                                                        class="action-btn btn-approve"
                                                        onclick="return confirm('Bạn có chắc muốn duyệt kỳ thi này?');">
                                                    Duyệt
                                                </button>

                                            </form>

                                            <button type="button"
                                                    class="action-btn btn-reject"
                                                    onclick="openRejectModal(@exam.Id, '@Html.Raw(exam.Name.Replace("'", "\\'"))')">
                                                Từ chối
                                            </button>
                                        }


                                        <!-- Đề đã duyệt → Xếp lịch -->
                                        @if (exam.Status == "Approved")
                                        {
                                            <a asp-controller="Admin"
                                               asp-action="ScheduleExam"
                                               asp-route-id="@exam.Id"
                                               class="action-btn btn-schedule">
                                                📅 Xếp lịch
                                            </a>
                                        }


                                        <!-- Đề đã xếp lịch → Sửa lịch + Công bố -->
                                        @if (exam.Status == "Scheduled")
                                        {
                                            <a asp-controller="Admin"
                                               asp-action="ScheduleExam"
                                               asp-route-id="@exam.Id"
                                               class="action-btn btn-edit-schedule">
                                                ✏️ Sửa lịch
                                            </a>

                                            <form asp-controller="Admin"
                                                  asp-action="PublishExam"
                                                  asp-route-id="@exam.Id"
                                                  method="post">

                                                @Html.AntiForgeryToken()

                                                <button type="submit"
                                                        class="action-btn btn-publish"
                                                        onclick="return confirm('Bạn có chắc muốn công bố kỳ thi này? Sau khi công bố, sinh viên có thể thấy kỳ thi theo lịch đã thiết lập.');">
                                                    📢 Công bố
                                                </button>

                                            </form>
                                        }

                                    </div>
                                </td>

                            </tr>
                        }

                    </tbody>

                </table>

            </div>
        }

    </div>

</div>


<!-- Reject Modal -->

<div id="rejectModal"
     style="
        display:none;
        position:fixed;
        inset:0;
        background:rgba(15,23,42,.55);
        z-index:9999;
        align-items:center;
        justify-content:center;
     ">

    <div style="
        width:90%;
        max-width:500px;
        background:white;
        border-radius:16px;
        padding:25px;
    ">

        <h2 style="
            margin-top:0;
            color:#0f172a;
        ">
            Từ chối kỳ thi
        </h2>

        <p style="color:#64748b;">
            Kỳ thi:
            <strong id="rejectExamName"></strong>
        </p>

        <form asp-controller="Admin"
              asp-action="RejectExam"
              method="post">

            @Html.AntiForgeryToken()

            <input type="hidden"
                   id="rejectExamId"
                   name="ExamId" />

            <label style="
                display:block;
                margin-bottom:8px;
                font-weight:600;
                color:#334155;
            ">
                Lý do từ chối
            </label>

            <textarea name="RejectReason"
                      required
                      maxlength="500"
                      style="
                        width:100%;
                        min-height:120px;
                        padding:12px;
                        border:1px solid #cbd5e1;
                        border-radius:9px;
                        resize:vertical;
                        box-sizing:border-box;
                      "
                      placeholder="Nhập lý do từ chối..."></textarea>

            <div style="
                display:flex;
                gap:10px;
                margin-top:20px;
            ">

                <button type="submit"
                        class="action-btn btn-reject">
                    Xác nhận từ chối
                </button>

                <button type="button"
                        class="action-btn"
                        style="
                            background:#e2e8f0;
                            color:#334155;
                        "
                        onclick="closeRejectModal()">
                    Hủy
                </button>

            </div>

        </form>

    </div>

</div>


<script>
    function openRejectModal(id, name) {

        document.getElementById("rejectExamId").value = id;

        document.getElementById("rejectExamName")
            .textContent = name;

        document.getElementById("rejectModal")
            .style.display = "flex";
    }

    function closeRejectModal() {

        document.getElementById("rejectModal")
            .style.display = "none";
    }

    document.getElementById("rejectModal")
        .addEventListener("click", function (event) {

            if (event.target === this) {
                closeRejectModal();
            }

        });

    document.addEventListener("keydown", function (event) {

        if (event.key === "Escape") {
            closeRejectModal();
        }

    });
</script>