@model List<Study.Models.User>
@{
    ViewData["Title"] = "Chọn giảng viên phân công";
}
<style>
 .pick-page{min-height:calc(100vh - 150px);padding:40px 5%;background:#f8fafc}
 .pick-wrap{max-width:1100px;margin:0 auto}
 .pick-head{display:flex;justify-content:space-between;align-items:center;gap:18px;margin-bottom:24px}
 .pick-head h1{margin:0;color:#0f172a;font-size:30px}
 .pick-head p{margin:8px 0 0;color:#64748b}
 .btn{display:inline-block;padding:10px 15px;border-radius:8px;text-decoration:none;font-weight:650}
 .btn-primary{background:#2563eb;color:#fff}.btn-secondary{background:#e2e8f0;color:#334155}
 .notice{padding:13px 16px;border-radius:9px;margin-bottom:16px}
 .ok{background:#dcfce7;color:#166534}.err{background:#fee2e2;color:#991b1b}
 .table-card{background:#fff;border-radius:14px;overflow:hidden;border:1px solid #e2e8f0}
 table{width:100%;border-collapse:collapse}th{background:#eff6ff;color:#1e3a8a;text-align:left;padding:15px}td{padding:15px;border-top:1px solid #e2e8f0;color:#334155}
 .state{display:inline-block;padding:5px 10px;border-radius:16px;font-size:12px;font-weight:700}.active{background:#dcfce7;color:#166534}.locked{background:#fee2e2;color:#991b1b}
 .empty{padding:45px;text-align:center;color:#64748b}
 @@media(max-width:700px){.pick-head{align-items:stretch;flex-direction:column}.table-card{overflow-x:auto}table{min-width:720px}}
</style>
<div class="pick-page"><div class="pick-wrap">
 <div class="pick-head"><div><h1>Phân công môn học</h1><p>Chọn giảng viên đang hoạt động để xem và cập nhật môn học được phân công.</p></div>
 <a asp-controller="Admin" asp-action="LecturerAssignments" class="btn btn-secondary">Xem tất cả phân công</a></div>
 @if(TempData["Success"] != null){<div class="notice ok">@TempData["Success"]</div>}
 @if(TempData["Error"] != null){<div class="notice err">@TempData["Error"]</div>}
 <div class="table-card">
 @if(Model == null || !Model.Any()){
  <div class="empty"><h3>Chưa có giảng viên</h3><p>Hiện chưa có tài khoản Lecturer để thực hiện phân công.</p></div>
 } else {
  <table><thead><tr><th>ID</th><th>Họ tên</th><th>Email</th><th>Trạng thái</th><th>Thao tác</th></tr></thead><tbody>
  @foreach(var lecturer in Model){<tr>
   <td>@lecturer.Id</td><td><strong>@lecturer.FullName</strong></td><td>@lecturer.Email</td>
   <td>@if(lecturer.IsActive){<span class="state active">Đang hoạt động</span>}else{<span class="state locked">Đã khóa</span>}</td>
   <td>@if(lecturer.IsActive){<a asp-controller="Admin" asp-action="AssignSubjects" asp-route-lecturerId="@lecturer.Id" class="btn btn-primary">Chọn giảng viên</a>}else{<span class="state locked">Không thể phân công</span>}</td>
  </tr>}
  </tbody></table>
 }
 </div>
</div></div>
