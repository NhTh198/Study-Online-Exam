@model List<Study.Models.Exam>
@{ ViewData["Title"] = "Lịch thi"; }
<div class="workspace">
    <section class="page-intro"><div><span class="eyebrow">QUẢN LÝ THỜI GIAN</span><h1>Lịch thi</h1><p>Danh sách các kỳ thi đã được xếp lịch và thời gian tổ chức.</p></div><a class="btn btn-outline-primary" asp-controller="Admin" asp-action="Exams">Quay lại kỳ thi</a></section>
    @if (Model == null || !Model.Any()) { <div class="empty-state"><div class="empty-symbol">◷</div><h3>Chưa có kỳ thi được xếp lịch</h3><p>Các kỳ thi sau khi được duyệt và xếp lịch sẽ hiển thị tại đây.</p><a class="btn btn-primary" asp-controller="Admin" asp-action="Exams">Đến quản lý kỳ thi</a></div> }
    else { <section class="content-panel"><div class="table-responsive"><table class="table align-middle redesigned-table"><thead><tr><th>Kỳ thi</th><th>Môn học</th><th>Giảng viên</th><th>Bắt đầu</th><th>Kết thúc</th><th>Thời lượng</th><th>Trạng thái</th><th></th></tr></thead><tbody>@foreach (var exam in Model) { <tr><td><strong>@exam.Name</strong><small class="d-block text-muted">Mã đề #@exam.Id</small></td><td>@exam.Subject.Name</td><td>@exam.Creator.FullName</td><td>@exam.Schedule!.StartTime.ToString("dd/MM/yyyy HH:mm")</td><td>@exam.Schedule.EndTime.ToString("dd/MM/yyyy HH:mm")</td><td>@exam.Schedule.DurationMinutes phút</td><td><span class="status-pill @(exam.Status == "Published" ? "status-live" : "status-scheduled")">@(exam.Status == "Published" ? "Đã công bố" : "Đã xếp lịch")</span></td><td>@if (exam.Status == "Scheduled") { <a class="btn btn-sm btn-outline-primary" asp-controller="Admin" asp-action="ScheduleExam" asp-route-id="@exam.Id">Chỉnh lịch</a> }</td></tr> }</tbody></table></div></section> }
</div>