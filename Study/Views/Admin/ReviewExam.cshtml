
@model Study.Models.Exam

@{
    ViewData["Title"] = "Duyệt kỳ thi";
}

<style>

    .page {
        width: 100%;
        min-height: calc(100vh - 150px);
        padding: 40px 5%;
        background: #f8fafc;
        box-sizing: border-box;
    }

    .header {
        display: flex;
        justify-content: space-between;
        align-items: flex-start;
        gap: 20px;
        margin-bottom: 25px;
    }

        .header h1 {
            margin: 0;
            color: #0f172a;
            font-size: 30px;
        }

        .header p {
            color: #64748b;
            margin-top: 8px;
        }

    .back-btn {
        padding: 10px 16px;
        background: #e2e8f0;
        color: #334155;
        text-decoration: none;
        border-radius: 8px;
        font-weight: 600;
    }

    .card {
        background: white;
        padding: 25px;
        border-radius: 14px;
        box-shadow: 0 4px 15px rgba(15, 23, 42, .06);
        margin-bottom: 25px;
    }

    .info-grid {
        display: grid;
        grid-template-columns: repeat(4, 1fr);
        gap: 20px;
    }

    .info label {
        display: block;
        color: #64748b;
        font-size: 13px;
        margin-bottom: 6px;
    }

    .info strong {
        color: #0f172a;
    }

    .status {
        display: inline-block;
        padding: 6px 10px;
        border-radius: 20px;
        font-size: 12px;
        font-weight: 700;
    }

    .pending {
        background: #fef3c7;
        color: #92400e;
    }

    .approved {
        background: #dcfce7;
        color: #166534;
    }

    .rejected {
        background: #fee2e2;
        color: #991b1b;
    }

    .question {
        padding: 20px 0;
        border-bottom: 1px solid #e2e8f0;
    }

        .question:last-child {
            border-bottom: none;
        }

    .question-title {
        font-weight: 700;
        color: #0f172a;
        margin-bottom: 12px;
        line-height: 1.5;
    }

    .options {
        display: grid;
        grid-template-columns: 1fr 1fr;
        gap: 10px;
    }

    .option {
        padding: 10px;
        background: #f8fafc;
        border-radius: 7px;
        color: #475569;
    }

    .correct {
        background: #dcfce7;
        color: #166534;
        font-weight: 600;
    }

    .actions {
        display: flex;
        gap: 10px;
        margin-top: 25px;
        flex-wrap: wrap;
    }

    .btn {
        padding: 11px 18px;
        border-radius: 8px;
        border: none;
        font-weight: 600;
        cursor: pointer;
    }

    .btn-approve {
        background: #16a34a;
        color: white;
    }

    .btn-reject {
        background: #dc2626;
        color: white;
    }

    .empty {
        padding: 30px;
        text-align: center;
        color: #64748b;
    }

    @@media (max-width: 900px) {

        .info-grid {
            grid-template-columns: 1fr 1fr;
        }

        .options {
            grid-template-columns: 1fr;
        }
    }

</style>


<div class="page">

    <div class="header">

        <div>

            <h1>
                @Model.Name
            </h1>

            <p>
                Kiểm tra và phê duyệt kỳ thi
            </p>

        </div>

        <a asp-controller="Admin"
           asp-action="Exams"
           class="back-btn">

            ← Quay lại

        </a>

    </div>


    <!-- THÔNG TIN -->

    <div class="card">

        <div class="info-grid">

            <div class="info">

                <label>
                    Môn học
                </label>

                <strong>
                    @Model.Subject?.Name
                </strong>

            </div>


            <div class="info">

                <label>
                    Người tạo
                </label>

                <strong>
                    @Model.Creator?.FullName
                </strong>

            </div>


            <div class="info">

                <label>
                    Số câu
                </label>

                <strong>
                    @(Model.ExamQuestions?.Count ?? 0)
                </strong>

            </div>


            <div class="info">

                <label>
                    Trạng thái
                </label>
                <div style="color:red;font-weight:bold;margin-top:10px;">
                    DEBUG STATUS: [@Model.Status]
                </div>
                @if (Model.Status == "PendingApproval")
                {
                    <span class="status pending">
                        Chờ duyệt
                    </span>
                }
                else if (Model.Status == "Approved")
                {
                    <span class="status approved">
                        Đã duyệt
                    </span>
                }
                else if (Model.Status == "Rejected")
                {
                    <span class="status rejected">
                        Từ chối
                    </span>
                }
                else
                {
                    <span class="status">
                        @Model.Status
                    </span>
                }

            </div>

        </div>


        @if (!string.IsNullOrWhiteSpace(Model.Description))
        {
            <div style="margin-top:20px;">

                <label style="color:#64748b;font-size:13px;">
                    Mô tả
                </label>

                <p>
                    @Model.Description
                </p>

            </div>
        }

    </div>


    <!-- CÂU HỎI -->

    <div class="card">

        <h2>
            Nội dung kỳ thi
        </h2>


        @if (Model.ExamQuestions == null ||
                !Model.ExamQuestions.Any())
        {
            <div class="empty">

                Đề thi chưa có câu hỏi.

            </div>
        }
        else
        {
            @foreach (var examQuestion in Model.ExamQuestions)
            {
                <div class="question">

                    <div class="question-title">

                        Câu @examQuestion.QuestionOrder.

                        @examQuestion.Question.Content

                    </div>


                    <div class="options">

                        @foreach (var option in
                                        examQuestion.Question.Options
                                        .OrderBy(x => x.Id))
                        {
                            <div class="
                                            option
                                            @(option.IsCorrect ? "correct" : "")">

                                @if (option.IsCorrect)
                                {
                                    <strong>✓ </strong>
                                }

                                @option.Content

                            </div>
                        }

                    </div>

                </div>
            }
        }


        <!-- ACTION -->
        @if (Model.Status == "PendingApproval")
        {
            <div class="actions">

                <form asp-controller="Admin"
                      asp-action="ApproveExam"
                      asp-route-id="@Model.Id"
                      method="post">

                    @Html.AntiForgeryToken()

                    <button type="submit"
                            class="btn btn-approve"
                            onclick="return confirm('Bạn có chắc muốn duyệt kỳ thi này?');">

                        ✓ Duyệt kỳ thi

                    </button>

                </form>


                <button type="button"
                        class="btn btn-reject"
                        onclick="openRejectModal()">

                    ✕ Từ chối

                </button>

            </div>
        }

    </div>

</div>


<!-- REJECT MODAL -->

<div id="rejectModal"
     style="
        display:none;
        position:fixed;
        inset:0;
        background:rgba(15,23,42,.5);
        align-items:center;
        justify-content:center;
        z-index:9999;">

    <div style="
        background:white;
        width:90%;
        max-width:500px;
        padding:25px;
        border-radius:14px;">

        <h2>
            Từ chối kỳ thi
        </h2>

        <form asp-controller="Admin"
              asp-action="RejectExam"
              method="post">

            @Html.AntiForgeryToken()

            <input type="hidden"
                   name="ExamId"
                   value="@Model.Id" />

            <label style="
                display:block;
                margin-bottom:8px;
                font-weight:600;">

                Lý do từ chối

            </label>

            <textarea name="RejectReason"
                      required
                      style="
                        width:100%;
                        min-height:120px;
                        padding:10px;
                        box-sizing:border-box;
                        border:1px solid #cbd5e1;
                        border-radius:8px;"
                      placeholder="Nhập lý do từ chối..."></textarea>


            <div style="
                display:flex;
                justify-content:flex-end;
                gap:10px;
                margin-top:15px;">

                <button type="button"
                        class="btn"
                        style="
                            background:#e2e8f0;
                            color:#334155;"
                        onclick="closeRejectModal()">

                    Hủy

                </button>

                <button type="submit"
                        class="btn btn-reject">

                    Xác nhận từ chối

                </button>

            </div>

        </form>

    </div>

</div>


<script>

    function openRejectModal() {

        document.getElementById(
            "rejectModal"
        ).style.display = "flex";

    }


    function closeRejectModal() {

        document.getElementById(
            "rejectModal"
        ).style.display = "none";

    }

</script>

