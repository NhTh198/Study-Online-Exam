@{ ViewData["Title"] = "Nhập câu hỏi từ Excel"; int subjectId = (int)Model; var subject = ViewBag.Subject as Study.Models.Subject; }
<div class="container py-5" style="max-width:900px"><div class="mb-4"><span class="text-primary fw-semibold">NGÂN HÀNG CÂU HỎI</span><h1 class="h2 fw-bold mt-2">Nhập câu hỏi từ Excel</h1><p class="text-secondary">Môn: @(subject?.Name ?? "")</p></div>
@if (TempData["Success"] != null) { <div class="alert alert-success">@TempData["Success"]</div> } @if (TempData["Error"] != null) { <div class="alert alert-danger">@TempData["Error"]</div> } @if (TempData["ImportErrors"] != null) { <div class="alert alert-warning">@TempData["ImportErrors"]</div> }
<div class="card border-0 shadow-sm rounded-4"><div class="card-body p-4"><h2 class="h5 fw-bold">Thứ tự cột bắt buộc</h2><div class="table-responsive"><table class="table table-sm"><thead><tr><th>Topic</th><th>Content</th><th>Difficulty</th><th>Option A</th><th>Option B</th><th>Option C</th><th>Option D</th><th>Correct</th></tr></thead><tbody><tr><td>Đại số</td><td>1 + 1 = ?</td><td>Easy</td><td>1</td><td>2</td><td>3</td><td>4</td><td>B</td></tr></tbody></table></div><p class="small text-secondary">Difficulty: Easy, Medium, Hard. Correct: A, B, C hoặc D. Mỗi câu phải có đủ 4 đáp án. Hàng đầu tiên là tiêu đề.</p><p><a asp-action="QuestionTemplate" asp-route-subjectId="@subjectId" class="link-primary">Tải tệp Excel mẫu</a></p><form asp-action="ImportQuestions" method="post" enctype="multipart/form-data"><input type="hidden" name="subjectId" value="@subjectId"/><div class="mb-3"><input class="form-control" type="file" name="file" accept=".xlsx" required/></div><button class="btn btn-primary" type="submit">Nhập câu hỏi</button> <a asp-controller="Lecturer" asp-action="Questions" asp-route-subjectId="@subjectId" class="btn btn-light">Quay lại ngân hàng</a></form></div></div></div>
