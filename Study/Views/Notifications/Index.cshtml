@model List<Study.Models.Notifications>
@{ ViewData["Title"] = "Thông báo"; }
<div class="container py-5" style="max-width:980px">
    <div class="d-flex flex-wrap justify-content-between align-items-center gap-3 mb-4"><div><span class="text-primary fw-semibold">STUDY</span><h1 class="h2 fw-bold mt-2 mb-1">Thông báo</h1><p class="text-secondary mb-0">Cập nhật liên quan đến đề thi, kỳ thi và tài khoản của bạn.</p></div>
        <form asp-action="MarkAllRead" method="post">@Html.AntiForgeryToken()<button class="btn btn-outline-primary" type="submit">Đánh dấu tất cả đã đọc</button></form></div>
    @if (Model.Count == 0) { <div class="card border-0 shadow-sm rounded-4"><div class="card-body text-center p-5"><div class="display-5">🔔</div><h2 class="h5 mt-3">Chưa có thông báo</h2><p class="text-secondary mb-0">Thông báo mới sẽ xuất hiện tại đây.</p></div></div> }
    else { <div class="d-grid gap-3">@foreach (var n in Model) { <div class="card border-0 shadow-sm rounded-4"><div class="card-body p-4"><div class="d-flex justify-content-between gap-3"><div><div class="d-flex align-items-center gap-2"><h2 class="h6 fw-bold mb-0">@n.Title</h2>@if (!n.IsRead) { <span class="badge text-bg-primary">Mới</span> }</div><p class="mb-2 mt-2">@n.Message</p><small class="text-secondary">@n.CreatedAt.ToString("dd/MM/yyyy HH:mm")</small></div>@if (!n.IsRead) { <form asp-action="MarkRead" method="post" class="flex-shrink-0">@Html.AntiForgeryToken()<input type="hidden" name="id" value="@n.Id"/><button class="btn btn-sm btn-light" type="submit">Đã đọc</button></form> }</div></div></div> }</div> }
</div>
