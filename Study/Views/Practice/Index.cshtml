
@model Study.ViewModels.PracticeStartViewModel

@{
    ViewData["Title"] = "Tự luyện";
}

<div class="container-fluid py-4">

    <div class="text-center mb-5">
        <h1 class="fw-bold text-primary">
            TỰ LUYỆN
        </h1>

        <p class="text-muted">
            Chọn môn học để bắt đầu bài luyện 40 câu trong 60 phút.
        </p>
    </div>


    @if (TempData["Error"] != null)
    {
        <div class="alert alert-danger">
            @TempData["Error"]
        </div>
    }


    <div class="row justify-content-center">

        <div class="col-12 col-md-8 col-lg-6">

            <div class="card shadow-sm border-0">

                <div class="card-body p-4">

                    <h4 class="fw-bold mb-4">
                        Chọn môn học
                    </h4>


                    <form asp-action="Start"
                          method="post">

                        @Html.AntiForgeryToken()


                        <div class="mb-4">

                            <label class="form-label fw-semibold">
                                Môn học
                            </label>

                            <select asp-for="SubjectId"
                                    class="form-select form-select-lg">

                                <option value="">
                                    -- Chọn môn học --
                                </option>

                                @foreach (var subject in Model.Subjects)
                                {
                                    <option value="@subject.Id">
                                        @subject.Name
                                        (@subject.QuestionCount câu)
                                    </option>
                                }

                            </select>

                            <span asp-validation-for="SubjectId"
                                  class="text-danger">
                            </span>

                        </div>


                        <div class="alert alert-primary">

                            <div class="fw-bold mb-2">
                                📚 Thông tin bài luyện
                            </div>

                            <div>
                                • 40 câu hỏi ngẫu nhiên
                            </div>

                            <div>
                                • Thời gian: 60 phút
                            </div>

                            <div>
                                • Tự động chấm điểm
                            </div>

                            <div>
                                • Hết giờ sẽ tự động nộp bài
                            </div>

                        </div>


                        <button type="submit"
                                class="btn btn-primary btn-lg w-100">

                            🚀 Bắt đầu luyện

                        </button>

                    </form>

                </div>

            </div>

        </div>

    </div>

</div>

@section Scripts
{
    @{
        await Html.RenderPartialAsync("_ValidationScriptsPartial");
    }
}
