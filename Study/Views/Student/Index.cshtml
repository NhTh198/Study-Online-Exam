@model List<Study.Models.Exam>

@{
    ViewData["Title"] = "Student Dashboard";
}

<style>

    .student-page {
        max-width: 1200px;
        margin: 30px auto;
        padding: 0 20px;
    }

    .student-header {
        background: white;
        border-radius: 16px;
        padding: 25px 30px;
        margin-bottom: 25px;
        box-shadow: 0 5px 20px rgba(0, 0, 0, 0.08);
    }

        .student-header h1 {
            margin: 0 0 8px;
            color: #1565c0;
        }

        .student-header p {
            margin: 0;
            color: #666;
        }

    .exam-title {
        color: #1565c0;
        margin-bottom: 20px;
    }

    .exam-grid {
        display: grid;
        grid-template-columns: repeat(auto-fit, minmax(320px, 1fr));
        gap: 20px;
    }

    .exam-card {
        background: white;
        border-radius: 14px;
        padding: 22px;
        box-shadow: 0 5px 18px rgba(0, 0, 0, 0.08);
        border: 1px solid #e5e5e5;
    }

        .exam-card h3 {
            margin-top: 0;
            margin-bottom: 12px;
            color: #1565c0;
        }

    .exam-info {
        margin: 10px 0;
        color: #444;
    }

        .exam-info strong {
            color: #333;
        }

    .exam-status {
        display: inline-block;
        background: #e8f5e9;
        color: #2e7d32;
        padding: 5px 10px;
        border-radius: 20px;
        font-size: 13px;
        font-weight: 600;
        margin-bottom: 12px;
    }

    .btn-start {
        display: inline-block;
        margin-top: 15px;
        padding: 11px 20px;
        background: #1976d2;
        color: white;
        border-radius: 8px;
        text-decoration: none;
        font-weight: 600;
    }

        .btn-start:hover {
            background: #125ca1;
        }

    .empty-box {
        background: white;
        padding: 35px;
        text-align: center;
        border-radius: 14px;
        color: #777;
        box-shadow: 0 5px 18px rgba(0, 0, 0, 0.06);
    }

    @@media (max-width: 600px) {
        .student-page

    {
        padding: 0 12px;
    }

    .student-header {
        padding: 20px;
    }

    .exam-grid {
        grid-template-columns: 1fr;
    }

    }
</style>

<div class="student-page">

   
    <div class="student-header">

        <h1>🎓 Student Dashboard</h1>

        <p>
            Chào mừng
            <strong>
                @Context.Session.GetString("FullName")
            </strong>
        </p>

    </div>
    
    <a asp-controller="Practice"
       asp-action="Index"
       class="btn btn-primary btn-lg px-4">
        📝 Bắt đầu tự luyện
    </a>
   
    <a asp-controller="Practice"
       asp-action="History"
       class="nav-link">
        📚 Lịch sử
    </a>

    <h2 class="exam-title">
        📚 Kỳ thi đã công bố
    </h2>


    @if (Model == null || !Model.Any())
    {
        <div class="empty-box">

            <h3>📭 Chưa có kỳ thi</h3>

            <p>
                Hiện tại chưa có kỳ thi nào được công bố.
            </p>

        </div>
    }
    else
    {
        <div class="exam-grid">

            @foreach (var exam in Model)
            {
                <div class="exam-card">

                    <span class="exam-status">
                        Đã công bố
                    </span>

                    <h3>
                        @exam.Name
                    </h3>

                    <div class="exam-info">
                        <strong>Môn học:</strong>
                        @exam.Subject.Name
                    </div>

                    <div class="exam-info">
                        <strong>Thời gian:</strong>
                        @exam.Schedule!.StartTime.ToString("dd/MM/yyyy HH:mm")
                        -
                        @exam.Schedule.EndTime.ToString("HH:mm")
                    </div>

                    <div class="exam-info">
                        <strong>Thời lượng:</strong>
                        @exam.Schedule.DurationMinutes phút
                    </div>

                    <div class="exam-info">
                        <strong>Số câu hỏi:</strong>
                        @exam.ExamQuestions.Count câu
                    </div>

                    <a asp-controller="Student"
                       asp-action="StartExam"
                       asp-route-id="@exam.Id"
                       class="btn-start">
                        🚀 Vào thi
                    </a>

                </div>
            }

        </div>
    }
    

</div>
