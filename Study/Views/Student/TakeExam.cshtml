    // Save answers in the background. The submit flow waits for in-flight
    // autosaves so the last changed answer is not lost at the deadline.
    let pendingSaves = [];
    let submitting = false;
    const saveQueues = new WeakMap();
    document.querySelectorAll('.autosave-question input').forEach(input => {
        input.addEventListener('change', () => {
            const form = input.closest('form');
            const badge = document.getElementById('saveStatus');
            if (badge) badge.textContent = 'Đang lưu...';
            const payload = new FormData(form);
            const previous = saveQueues.get(form) || Promise.resolve();
            let task;
            task = previous.catch(() => {}).then(async () => {
                try {
                    const response = await fetch(form.action, {
                        method: 'POST',
                        body: payload,
                        headers: { 'X-Requested-With': 'XMLHttpRequest' }
                    });
                    if (!response.ok) throw new Error('save failed');
                    if (badge) badge.textContent = 'Đã lưu tự động';
                } catch {
                    if (badge) badge.textContent = 'Chưa lưu được - vui lòng kiểm tra kết nối';
                }
            }).finally(() => {
                pendingSaves = pendingSaves.filter(item => item !== task);
            });
            saveQueues.set(form, task);
            pendingSaves.push(task);
        });
    });
    const status = document.createElement('div');
