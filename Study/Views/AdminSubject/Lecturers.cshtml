@model List<Study.Models.User>

@{
    ViewData["Title"] = "Quản lý Lecturer";
}

<style>
    .lecturer-page {
        width: 100%;
        min-height: calc(100vh - 150px);
        padding: 40px 5%;
        background: #f8fafc;
        box-sizing: border-box;
    }

    .page-header {
        display: flex;
        justify-content: space-between;
        align-items: center;
        gap: 20px;
        margin-bottom: 25px;
    }

    .page-title h1 {
        margin: 0;
        color: #0f172a;
        font-size: 30px;
    }

    .page-title p {
        margin: 8px 0 0;
        color: #64748b;
    }

    .header-buttons {
        display: flex;
        gap: 10px;
        flex-wrap: wrap;
    }

    .btn {
        display: inline-flex;
        align-items: center;
        justify-content: center;
        padding: 11px 18px;
        border-radius: 9px;
        text-decoration: none;
        border: none;
        font-weight: 600;
        cursor: pointer;
    }

    .btn-blue {
        background: #2563eb;
        color: white;
    }

        .btn-blue:hover {
            background: #1d4ed8;
            color: white;
        }

    .btn-gray {
        background: #e2e8f0;
        color: #334155;
    }

        .btn-gray:hover {
            background: #cbd5e1;
        }

    .alert {
        padding: 14px 18px;
        border-radius: 10px;
        margin-bottom: 20px;
        font-weight: 500;
    }

    .alert-success {
        background: #dcfce7;
        color: #166534;
    }

    .alert-error {
        background: #fee2e2;
        color: #991b1b;
    }

    .table-card {
        background: white;
        border-radius: 16px;
        overflow: hidden;
        box-shadow: 0 4px 15px rgba(15, 23, 42, 0.06);
    }

    .table-wrapper {
        width: 100%;
        overflow-x: auto;
    }

    table {
        width: 100%;
        min-width: 900px;
        border-collapse: collapse;
    }

    th {
        background: #eff6ff;
        color: #1e3a8a;
        text-align: left;
        padding: 16px;
        font-size: 14px;
        white-space: nowrap;
    }

    td {
        padding: 16px;
        border-top: 1px solid #e2e8f0;
        color: #334155;
        vertical-align: middle;
    }

    tr:hover {
        background: #f8fafc;
    }

    .lecturer-name {
        font-weight: 600;
        color: #0f172a;
    }

    .email {
        color: #475569;
    }

    .status {
        display: inline-block;
        padding: 6px 11px;
        border-radius: 20px;
        font-size: 13px;
        font-weight: 600;
    }

    .active {
        background: #dcfce7;
        color: #166534;
    }

    .locked {
        background: #fee2e2;
        color: #991b1b;
    }

    .actions {
        display: flex;
        flex-wrap: wrap;
        gap: 7px;
    }

    .action-btn {
        display: inline-block;
        padding: 8px 11px;
        border: none;
        border-radius: 7px;
        text-decoration: none;
        font-size: 13px;
        font-weight: 600;
        cursor: pointer;
    }

    .btn-edit {
        background: #dbeafe;
        color: #1d4ed8;
    }

    .btn-subject {
        background: #ede9fe;
        color: #6d28d9;
    }

    .btn-lock {
        background: #fef3c7;
        color: #92400e;
    }

    .btn-unlock {
        background: #dcfce7;
        color: #166534;
    }

    .btn-reset {
        background: #e0f2fe;
        color: #0369a1;
    }

    .btn-delete {
        background: #fee2e2;
        color: #b91c1c;
    }

    .empty {
        text-align: center;
        padding: 60px 20px;
        color: #64748b;
    }

    .empty-icon {
        font-size: 45px;
        margin-bottom: 10px;
    }

    @@media (max-width: 700px) {
        .lecturer-page {
            padding: 25px 15px;
        }

        .page-header {
            flex-direction: column;
            align-items: stretch;
        }

        .header-buttons {
            flex-direction: column;
        }

            .header-buttons .btn {
                width: 100%;
            }
    }
</style>

<div class="lecturer-page">

    <div class="page-header">

        <div class="page-title">
            <h1>Quản lý Lecturer</h1>
            <p>Quản lý giảng viên và phân công môn học.</p>
        </div>

        <div class="header-buttons">

            <a asp-controller="AdminSubject"
               asp-action="CreateUser"
               class="btn btn-blue">
                + Thêm Lecturer
            </a>

            <a asp-controller="AdminSubject"
               asp-action="LecturerAssignments"
               class="btn btn-gray">
                📚 Xem phân công
            </a>

        </div>

    </div>


    @if (TempData["Success"] != null)
    {
        <div class="alert alert-success">
            @TempData["Success"]
        </div>
    }

    @if (TempData["Error"] != null)
    {
        <div class="alert alert-error">
            @TempData["Error"]
        </div>
    }


    <div class="table-card">

        @if (Model == null || !Model.Any())
        {
            <div class="empty">

                <div class="empty-icon">👨‍🏫</div>

                <h3>Chưa có Lecturer</h3>

                <p>
                    Hãy tạo tài khoản Lecturer trước.
                </p>

            </div>
        }
        else
        {
            <div class="table-wrapper">

                <table>

                    <thead>
                        <tr>
                            <th>ID</th>
                            <th>Họ tên</th>
                            <th>Email</th>
                            <th>Trạng thái</th>
                            <th>Ngày tạo</th>
                            <th>Thao tác</th>
                        </tr>
                    </thead>

                    <tbody>

                        @foreach (var lecturer in Model)
                        {
                            <tr>

                                <td>
                                    @lecturer.Id
                                </td>

                                <td>
                                    <span class="lecturer-name">
                                        @lecturer.FullName
                                    </span>
                                </td>

                                <td>
                                    <span class="email">
                                        @lecturer.Email
                                    </span>
                                </td>

                                <td>

                                    @if (lecturer.IsActive)
                                    {
                                        <span class="status active">
                                            Đang hoạt động
                                        </span>
                                    }
                                    else
                                    {
                                        <span class="status locked">
                                            Đã khóa
                                        </span>
                                    }

                                </td>

                                <td>
                                    @lecturer.CreatedAt.ToString("dd/MM/yyyy HH:mm")
                                </td>

                                <td>

                                    <div class="actions">

                                        <a asp-controller="AdminSubject"
                                           asp-action="EditUser"
                                           asp-route-id="@lecturer.Id"
                                           class="action-btn btn-edit">
                                            Sửa
                                        </a>

                                        <a asp-controller="AdminSubject"
                                           asp-action="AssignSubjects"
                                           asp-route-lecturerId="@lecturer.Id"
                                           class="action-btn btn-subject">
                                            Môn học
                                        </a>

                                        <form asp-controller="AdminSubject"
                                              asp-action="ToggleActive"
                                              asp-route-id="@lecturer.Id"
                                              method="post"
                                              style="display:inline;">

                                            @Html.AntiForgeryToken()

                                            @if (lecturer.IsActive)
                                            {
                                                <button type="submit"
                                                        class="action-btn btn-lock"
                                                        onclick="return confirm('Bạn có chắc muốn khóa Lecturer này?');">
                                                    Khóa
                                                </button>
                                            }
                                            else
                                            {
                                                <button type="submit"
                                                        class="action-btn btn-unlock">
                                                    Mở khóa
                                                </button>
                                            }

                                        </form>

                                        <form asp-controller="AdminSubject"
                                              asp-action="DeleteUser"
                                              asp-route-id="@lecturer.Id"
                                              method="post"
                                              style="display:inline;">

                                            @Html.AntiForgeryToken()

                                            <button type="submit"
                                                    class="action-btn btn-delete"
                                                    onclick="return confirm('Bạn có chắc muốn xóa Lecturer này?');">
                                                Xóa
                                            </button>

                                        </form>

                                    </div>

                                </td>

                            </tr>
                        }

                    </tbody>

                </table>

            </div>
        }

    </div>

</div>