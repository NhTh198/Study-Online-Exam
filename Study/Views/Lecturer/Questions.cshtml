
@model List<Study.Models.Question>

@{
    ViewData["Title"] = "Ngân hàng câu hỏi";

    var subjects = ViewBag.Subjects
        as List<Study.Models.Subject>
        ?? new List<Study.Models.Subject>();

    int? selectedSubjectId = ViewBag.SelectedSubjectId;
}

<style>

    .question-page {
        width: 100%;
        min-height: calc(100vh - 150px);
        padding: 40px 5%;
        background: #f8fafc;
        box-sizing: border-box;
    }


    /* =========================
           HEADER
           ========================= */

    .page-header {
        display: flex;
        justify-content: space-between;
        align-items: center;
        gap: 20px;
        margin-bottom: 25px;
    }


        .page-header h1 {
            margin: 0;
            color: #0f172a;
            font-size: 30px;
        }


        .page-header p {
            margin-top: 8px;
            color: #64748b;
        }


    .btn-add {
        background: #2563eb;
        color: white;
        text-decoration: none;
        padding: 11px 18px;
        border-radius: 8px;
        font-weight: 600;
        white-space: nowrap;
    }


        .btn-add:hover {
            background: #1d4ed8;
        }


    /* =========================
           ALERT
           ========================= */

    .alert {
        padding: 14px 18px;
        border-radius: 10px;
        margin-bottom: 20px;
        font-weight: 500;
    }


    .alert-success {
        background: #dcfce7;
        color: #166534;
    }


    .alert-error {
        background: #fee2e2;
        color: #991b1b;
    }


    /* =========================
           FILTER
           ========================= */

    .filter-card {
        background: white;
        padding: 20px;
        border-radius: 14px;
        margin-bottom: 20px;
        box-shadow: 0 4px 15px rgba(15, 23, 42, .06);
    }


    .filter-form {
        display: flex;
        gap: 12px;
        align-items: end;
        flex-wrap: wrap;
    }


    .filter-group {
        min-width: 250px;
    }


        .filter-group label {
            display: block;
            margin-bottom: 7px;
            font-weight: 600;
            color: #334155;
        }


        .filter-group select {
            width: 100%;
            padding: 10px;
            border: 1px solid #cbd5e1;
            border-radius: 8px;
            background: white;
            box-sizing: border-box;
        }


    .btn-filter {
        padding: 10px 18px;
        border: none;
        border-radius: 8px;
        background: #0f172a;
        color: white;
        cursor: pointer;
        font-weight: 600;
    }


        .btn-filter:hover {
            background: #1e293b;
        }


    /* =========================
           TABLE
           ========================= */

    .table-card {
        background: white;
        border-radius: 16px;
        overflow: hidden;
        box-shadow: 0 4px 15px rgba(15, 23, 42, .06);
    }


    .table-wrapper {
        width: 100%;
        overflow-x: auto;
    }


    table {
        width: 100%;
        min-width: 1150px;
        border-collapse: collapse;
    }


    th {
        background: #eff6ff;
        color: #1e3a8a;
        padding: 15px;
        text-align: left;
        white-space: nowrap;
        font-size: 14px;
    }


    td {
        padding: 15px;
        border-top: 1px solid #e2e8f0;
        vertical-align: middle;
        color: #334155;
        font-size: 14px;
    }


    tr:hover {
        background: #f8fafc;
    }


    /* =========================
           QUESTION CONTENT
           ========================= */

    .question-content {
        max-width: 450px;
        font-weight: 600;
        color: #0f172a;
        line-height: 1.5;
    }


    /* =========================
           SUBJECT
           ========================= */

    .subject-code {
        display: inline-block;
        padding: 5px 9px;
        background: #dbeafe;
        color: #1d4ed8;
        border-radius: 6px;
        font-size: 12px;
        font-weight: 700;
        margin-bottom: 5px;
    }


    /* =========================
           DIFFICULTY
           ========================= */

    .difficulty {
        display: inline-block;
        padding: 5px 9px;
        border-radius: 20px;
        font-size: 12px;
        font-weight: 600;
    }


    .difficulty-easy {
        background: #dcfce7;
        color: #166534;
    }


    .difficulty-medium {
        background: #fef3c7;
        color: #92400e;
    }


    .difficulty-hard {
        background: #fee2e2;
        color: #991b1b;
    }


    /* =========================
           OPTIONS
           ========================= */

    .option-count {
        color: #64748b;
        white-space: nowrap;
    }


    /* =========================
           ACTIONS
           ========================= */

    .question-actions {
        display: flex;
        align-items: center;
        gap: 8px;
        white-space: nowrap;
    }


        .question-actions form {
            margin: 0;
            padding: 0;
        }


    .action-btn {
        display: inline-block;
        border: none;
        padding: 8px 11px;
        border-radius: 7px;
        text-decoration: none;
        cursor: pointer;
        font-size: 13px;
        font-weight: 600;
        white-space: nowrap;
    }


    .btn-edit {
        background: #dbeafe;
        color: #1d4ed8;
    }


        .btn-edit:hover {
            background: #bfdbfe;
        }


    .btn-delete {
        background: #fee2e2;
        color: #b91c1c;
    }


        .btn-delete:hover {
            background: #fecaca;
        }


    /* =========================
           EMPTY
           ========================= */

    .empty {
        padding: 60px 20px;
        text-align: center;
        color: #64748b;
    }


        .empty h3 {
            color: #334155;
            margin-bottom: 8px;
        }


        .empty p {
            margin: 0;
        }


    /* =========================
           MOBILE
           ========================= */

    @@media (max-width: 700px) {

        .question-page {
            padding: 25px 15px;
        }


        .page-header {
            align-items: flex-start;
            flex-direction: column;
        }


        .filter-group {
            width: 100%;
            min-width: 0;
        }


        .btn-filter {
            width: 100%;
        }


        .question-content {
            max-width: 300px;
        }
    }

</style>


<div class="question-page">


    <!-- =========================
         HEADER
         ========================= -->

    <div class="page-header">

        <div>

            <h1>
                Ngân hàng câu hỏi
            </h1>

            <p>
                Quản lý các câu hỏi thuộc môn học được Admin phân công.
            </p>

        </div>


        @if (subjects.Any())
        {
            <div class="d-flex flex-wrap gap-2">
                <a asp-controller="Lecturer" asp-action="ImportQuestions" class="btn btn-outline-success">
                    <i class="bi bi-file-earmark-excel"></i> Nhập từ Excel
                </a>
                <a asp-controller="Lecturer"
                   asp-action="CreateQuestion"
                   asp-route-subjectId="@(selectedSubjectId ?? subjects.First().Id)"
                   class="btn-add">+ Thêm thủ công</a>
            </div>
        }

    </div>


    <!-- =========================
         SUCCESS MESSAGE
         ========================= -->
    @if (TempData["Success"] != null)
    {
        <div class="alert alert-success">

            @TempData["Success"]

        </div>
    }


    <!-- =========================
         ERROR MESSAGE
         ========================= -->
    @if (TempData["Error"] != null)
    {
        <div class="alert alert-error">

            @TempData["Error"]

        </div>
    }


    <!-- =========================
         FILTER
         ========================= -->

    <div class="filter-card">

        <form asp-controller="Lecturer"
              asp-action="Questions"
              method="get"
              class="filter-form">


            <div class="filter-group">

                <label>
                    Môn học
                </label>


                <select name="subjectId">

                    @if (!selectedSubjectId.HasValue)
                    {
                        <option value="" selected>
                            -- Tất cả môn được phân công --
                        </option>
                    }
                    else
                    {
                        <option value="">
                            -- Tất cả môn được phân công --
                        </option>
                    }


                    @foreach (var subject in subjects)
                    {
                        @if (selectedSubjectId.HasValue &&
                                            selectedSubjectId.Value == subject.Id)
                        {
                            <option value="@subject.Id" selected>
                                @subject.Code - @subject.Name
                            </option>
                        }
                        else
                        {
                            <option value="@subject.Id">
                                @subject.Code - @subject.Name
                            </option>
                        }
                    }

                </select>

            </div>


            <div class="filter-group">
                <label>Tìm câu hỏi</label>
                <input type="text" name="search" value="@ViewBag.Search" placeholder="Nội dung hoặc chủ đề" />
            </div>
            <button type="submit"
                    class="btn-filter">

                Lọc

            </button>


        </form>

    </div>


    <!-- =========================
         QUESTION TABLE
         ========================= -->

    <div class="table-card">


        @if (Model == null || !Model.Any())
        {
            <div class="empty">

                <h3>
                    Chưa có câu hỏi
                </h3>

                <p>
                    Hiện chưa có câu hỏi nào thuộc phạm vi của bạn.
                </p>

            </div>
        }
        else
        {

            <div class="table-wrapper">

                <table>

                    <thead>

                        <tr>

                            <th>
                                ID
                            </th>

                            <th>
                                Môn
                            </th>

                            <th>
                                Câu hỏi
                            </th>

                            <th>
                                Chủ đề
                            </th>

                            <th>
                                Độ khó
                            </th>

                            <th>
                                Đáp án
                            </th>

                            <th>
                                Ngày tạo
                            </th>

                            <th>
                                Thao tác
                            </th>

                        </tr>

                    </thead>


                    <tbody>

                        @foreach (var question in Model)
                        {

                            <tr>


                                <!-- ID -->

                                <td>
                                    @question.Id
                                </td>


                                <!-- SUBJECT -->

                                <td>

                                    <span class="subject-code">
                                        @question.Subject.Code
                                    </span>

                                    <br />

                                    @question.Subject.Name

                                </td>


                                <!-- QUESTION -->

                                <td>

                                    <div class="question-content">

                                        @question.Content

                                    </div>

                                </td>


                                <!-- TOPIC -->

                                <td>

                                    @if (string.IsNullOrWhiteSpace(question.Topic))
                                    {
                                        <span>—</span>
                                    }
                                    else
                                    {
                                        @question.Topic
                                    }

                                </td>


                                <!-- DIFFICULTY -->

                                <td>

                                    @{
                                        var difficultyClass =
                                        question.Difficulty?.ToLower() switch
                                        {
                                            "easy" => "difficulty-easy",
                                            "medium" => "difficulty-medium",
                                            "hard" => "difficulty-hard",
                                            _ => "difficulty-medium"
                                        };
                                    }


                                    <span class="difficulty @difficultyClass">

                                        @if (question.Difficulty == "Easy")
                                        {
                                            <text>Dễ</text>
                                        }
                                        else if (question.Difficulty == "Medium")
                                        {
                                            <text>Trung bình</text>
                                        }
                                        else if (question.Difficulty == "Hard")
                                        {
                                            <text>Khó</text>
                                        }
                                        else
                                        {
                                            @question.Difficulty
                                        }

                                    </span>

                                </td>


                                <!-- OPTIONS -->

                                <td>

                                    <span class="option-count">

                                        @question.Options.Count đáp án

                                    </span>

                                </td>


                                <!-- CREATED DATE -->

                                <td>

                                    @question.CreatedAt.ToString("dd/MM/yyyy HH:mm")

                                </td>


                                <!-- ACTIONS -->

                                <td>

                                    <div class="question-actions">


                                        <!-- EDIT -->

                                        <a asp-controller="Lecturer"
                                           asp-action="EditQuestion"
                                           asp-route-id="@question.Id"
                                           class="action-btn btn-edit">

                                            ✏️ Sửa

                                        </a>


                                        <!-- DELETE -->

                                        <form asp-controller="Lecturer"
                                              asp-action="DeleteQuestion"
                                              asp-route-id="@question.Id"
                                              method="post"
                                              onsubmit="return confirm('Bạn có chắc muốn xóa câu hỏi này?');">

                                            @Html.AntiForgeryToken()

                                            <button type="submit"
                                                    class="action-btn btn-delete">

                                                🗑️ Xóa

                                            </button>

                                        </form>


                                    </div>

                                </td>


                            </tr>

                        }

                    </tbody>

                </table>

            </div>

        }

    </div>
    @if ((int)(ViewBag.TotalPages ?? 1) > 1)
    {
        <nav class="d-flex justify-content-center gap-2 my-4">
            @for (int p = 1; p <= (int)ViewBag.TotalPages; p++)
            { <a class="btn @(p == (int)ViewBag.Page ? "btn-primary" : "btn-outline-primary")" asp-action="Questions" asp-route-page="@p" asp-route-subjectId="@selectedSubjectId" asp-route-search="@ViewBag.Search">@p</a> }
        </nav>
    }

</div>
