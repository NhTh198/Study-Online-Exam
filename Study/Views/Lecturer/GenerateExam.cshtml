@{ ViewData["Title"] = "Tạo đề thi tự động"; var subjects = ViewBag.Subjects as List<Study.Models.Subject> ?? new(); }
<div class="container py-5" style="max-width:900px"><div class="mb-4"><span class="text-primary fw-semibold">CÔNG CỤ GIẢNG VIÊN</span><h1 class="h2 fw-bold mt-2">Tạo đề thi tự động</h1><p class="text-secondary">Chọn môn học và phân bổ số câu theo mức độ từ ngân hàng câu hỏi hiện có.</p></div>
@if (TempData["Error"] != null) { <div class="alert alert-danger">@TempData["Error"]</div> }
<div class="card border-0 shadow-sm rounded-4"><div class="card-body p-4 p-md-5"><form asp-action="GenerateExam" method="post"><div class="mb-3"><label class="form-label fw-semibold">Tên đề thi</label><input class="form-control" name="name" maxlength="200" required placeholder="Ví dụ: Kiểm tra giữa kỳ"/></div><div class="mb-3"><label class="form-label fw-semibold">Môn học</label><select class="form-select" name="subjectId" required><option value="">-- Chọn môn --</option>@foreach(var s in subjects){<option value="@s.Id">@s.Code - @s.Name</option>}</select></div><div class="row g-3"><div class="col-md-4"><label class="form-label fw-semibold">Câu dễ</label><input class="form-control" type="number" name="easyCount" min="0" max="200" value="5"/></div><div class="col-md-4"><label class="form-label fw-semibold">Câu trung bình</label><input class="form-control" type="number" name="mediumCount" min="0" max="200" value="5"/></div><div class="col-md-4"><label class="form-label fw-semibold">Câu khó</label><input class="form-control" type="number" name="hardCount" min="0" max="200" value="2"/></div></div><div class="mt-3 mb-4"><label class="form-label fw-semibold">Mô tả (không bắt buộc)</label><textarea class="form-control" name="description" rows="3"></textarea></div><div class="alert alert-info">Đề được tạo ở trạng thái Nháp. Hệ thống kiểm tra số câu khả dụng trước khi tạo; mỗi câu trong đề là duy nhất.</div><button class="btn btn-primary px-4" type="submit">Tạo đề tự động</button> <a asp-action="MyExams" class="btn btn-light">Quay lại</a></form></div></div></div>
