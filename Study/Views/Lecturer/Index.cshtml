
@model List<Study.Models.Subject>

@{
    ViewData["Title"] = "Lecturer Dashboard";
}

<style>

    .dashboard {
        width: 100%;
        min-height: calc(100vh - 150px);
        padding: 40px 5%;
        background: #f8fafc;
        box-sizing: border-box;
    }

    .header {
        margin-bottom: 30px;
    }

        .header h1 {
            margin: 0;
            color: #0f172a;
            font-size: 30px;
        }

        .header p {
            color: #64748b;
            margin-top: 8px;
        }

    .menu {
        display: grid;
        grid-template-columns: repeat(3, 1fr);
        gap: 20px;
        margin-bottom: 35px;
    }

    .menu-card {
        background: white;
        padding: 25px;
        border-radius: 14px;
        box-shadow: 0 4px 15px rgba(15, 23, 42, .06);
        text-decoration: none;
        border: 1px solid #e2e8f0;
        transition: .2s;
    }

        .menu-card:hover {
            transform: translateY(-3px);
            border-color: #93c5fd;
            box-shadow: 0 8px 20px rgba(37, 99, 235, .1);
        }

    .menu-icon {
        font-size: 30px;
        margin-bottom: 12px;
    }

    .menu-card h3 {
        margin: 0 0 8px;
        color: #0f172a;
    }

    .menu-card p {
        margin: 0;
        color: #64748b;
        font-size: 14px;
        line-height: 1.5;
    }

    .section {
        background: white;
        padding: 25px;
        border-radius: 14px;
        box-shadow: 0 4px 15px rgba(15, 23, 42, .06);
    }

        .section h2 {
            margin-top: 0;
            color: #0f172a;
        }

    .subject-list {
        display: grid;
        grid-template-columns: repeat(3, 1fr);
        gap: 15px;
    }

    .subject {
        padding: 18px;
        background: #f8fafc;
        border-radius: 10px;
        border: 1px solid #e2e8f0;
    }

    .subject-code {
        font-size: 13px;
        font-weight: 700;
        color: #2563eb;
        margin-bottom: 6px;
    }

    .subject-name {
        font-weight: 600;
        color: #334155;
    }

    .empty {
        padding: 30px;
        text-align: center;
        color: #64748b;
        background: #f8fafc;
        border-radius: 10px;
    }

    @@media (max-width: 900px) {

        .menu {
            grid-template-columns: 1fr;
        }

        .subject-list {
            grid-template-columns: 1fr;
        }
    }

</style>


<div class="dashboard">

    <div class="header">

        <h1>
            Lecturer Dashboard
        </h1>

        <p>
            Quản lý câu hỏi và kỳ thi của bạn.
        </p>

    </div>


    <!-- MENU -->

    <div class="menu">

        <a asp-controller="Lecturer"
           asp-action="Questions"
           class="menu-card">

            <div class="menu-icon">
                📚
            </div>

            <h3>
                Question Bank
            </h3>

            <p>
                Quản lý câu hỏi thuộc các môn học được phân công.
            </p>

        </a>


        <a asp-controller="Lecturer"
           asp-action="CreateExam"
           class="menu-card">

            <div class="menu-icon">
                📝
            </div>

            <h3>
                Tạo kỳ thi
            </h3>

            <p>
                Tạo đề thi từ các câu hỏi trong Question Bank.
            </p>

        </a>


        <a asp-controller="Lecturer"
           asp-action="MyExams"
           class="menu-card">

            <div class="menu-icon">
                📋
            </div>

            <h3>
                Kỳ thi của tôi
            </h3>

            <p>
                Xem và quản lý các kỳ thi đã tạo.
            </p>

        </a>

    </div>


    <!-- SUBJECTS -->

    <div class="section">

        <h2>
            Môn học được phân công
        </h2>


        @if (!Model.Any())
        {
            <div class="empty">

                Bạn chưa được Admin phân công môn học nào.

            </div>
        }
        else
        {
            <div class="subject-list">

                @foreach (var subject in Model)
                {
                    <div class="subject">

                        <div class="subject-code">
                            @subject.Code
                        </div>

                        <div class="subject-name">
                            @subject.Name
                        </div>

                    </div>
                }

            </div>
        }

    </div>

</div>
