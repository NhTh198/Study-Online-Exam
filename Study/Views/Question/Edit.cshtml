@model Study.Controllers.QuestionFormViewModel

@{
    ViewData["Title"] = "Edit Question";
}

<div class="container py-4">
    <div class="mb-4">
        <a asp-action="Index" class="text-decoration-none text-muted">
            <i class="bi bi-arrow-left"></i> Back to Question Bank
        </a>
        <h3 class="fw-bold mt-3">Edit Question</h3>
        <p class="text-muted">Update question information and answer options.</p>
    </div>

    <form asp-action="Edit" asp-route-id="@Model.Id" method="post">
        @Html.AntiForgeryToken()

        <input type="hidden" asp-for="Id" />

        <div asp-validation-summary="ModelOnly"
             class="alert alert-danger"></div>

        <div class="card border-0 shadow-sm mb-4">
            <div class="card-header bg-white py-3">
                <h5 class="fw-bold mb-0">Question Information</h5>
            </div>

            <div class="card-body">
                <div class="row g-3">
                    <div class="col-md-6">
                        <label asp-for="SubjectId" class="form-label fw-semibold">
                            Subject
                        </label>
                        <select asp-for="SubjectId"
                                asp-items="ViewBag.Subjects"
                                class="form-select">
                            <option value="">-- Select subject --</option>
                        </select>
                        <span asp-validation-for="SubjectId"
                              class="text-danger"></span>
                    </div>

                    <div class="col-md-6">
                        <label asp-for="Topic" class="form-label fw-semibold">
                            Topic
                        </label>
                        <input asp-for="Topic" class="form-control"
                               placeholder="Enter topic..." />
                    </div>

                    <div class="col-12">
                        <label asp-for="Content" class="form-label fw-semibold">
                            Question Content
                        </label>
                        <textarea asp-for="Content"
                                  class="form-control"
                                  rows="4"></textarea>
                        <span asp-validation-for="Content"
                              class="text-danger"></span>
                    </div>

                    <div class="col-md-6">
                        <label asp-for="Difficulty"
                               class="form-label fw-semibold">
                            Difficulty
                        </label>
                        <select asp-for="Difficulty" class="form-select">
                            <option value="Easy">Easy</option>
                            <option value="Medium">Medium</option>
                            <option value="Hard">Hard</option>
                        </select>
                    </div>
                </div>
            </div>
        </div>

        <div class="card border-0 shadow-sm mb-4">
            <div class="card-header bg-white py-3">
                <h5 class="fw-bold mb-1">Answer Options</h5>
                <small class="text-muted">
                    Select exactly one correct answer.
                </small>
            </div>

            <div class="card-body">
                <span asp-validation-for="Options"
                      class="text-danger d-block mb-3"></span>

                @for (int i = 0; i < Model.Options.Count; i++)
                {
                    <div class="row g-2 align-items-center mb-3">
                        <input type="hidden" asp-for="Options[i].Id" />

                        <div class="col-auto">
                            <span class="badge bg-light text-dark border">
                                @((char)('A' + i))
                            </span>
                        </div>

                        <div class="col">
                            <input asp-for="Options[i].Content"
                                   class="form-control"
                                   placeholder="Enter answer..." />
                        </div>

                        <div class="col-auto">
                            <div class="form-check">
                                <input asp-for="Options[i].IsCorrect"
                                       class="form-check-input correct-option"
                                       type="checkbox" />
                                <label class="form-check-label">
                                    Correct
                                </label>
                            </div>
                        </div>
                    </div>
                }

                @for (int i = Model.Options.Count; i < Model.Options.Count + 2; i++)
                {
                    <div class="row g-2 align-items-center mb-3">
                        <input type="hidden" name="Options[@i].Id" value="0" />

                        <div class="col-auto">
                            <span class="badge bg-light text-dark border">
                                @((char)('A' + i))
                            </span>
                        </div>

                        <div class="col">
                            <input name="Options[@i].Content"
                                   class="form-control"
                                   placeholder="Add another answer (optional)..." />
                        </div>

                        <div class="col-auto">
                            <div class="form-check">
                                <input name="Options[@i].IsCorrect"
                                       value="true"
                                       type="checkbox"
                                       class="form-check-input correct-option" />
                                <label class="form-check-label">
                                    Correct
                                </label>
                            </div>
                        </div>
                    </div>
                }
            </div>
        </div>

        <div class="d-flex justify-content-end gap-2">
            <a asp-action="Index" class="btn btn-light border">
                Cancel
            </a>
            <button type="submit" class="btn btn-primary px-4">
                <i class="bi bi-save me-1"></i> Update Question
            </button>
        </div>
    </form>
</div>

@section Scripts {
    <partial name="_ValidationScriptsPartial" />
}
