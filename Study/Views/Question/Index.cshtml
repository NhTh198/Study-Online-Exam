@model IEnumerable<Study.Models.Question>

@{
    ViewData["Title"] = "Question Bank";
    var subjects = ViewBag.Subjects as Microsoft.AspNetCore.Mvc.Rendering.SelectList;
}

<div class="container-fluid py-4">
    <div class="d-flex justify-content-between align-items-center mb-4 flex-wrap gap-3">
        <div>
            <h3 class="fw-bold mb-1">English Question Bank</h3>
            <p class="text-muted mb-0">Manage and organize your question bank</p>
        </div>

        <a asp-action="Create" class="btn btn-primary">
            <i class="bi bi-plus-circle me-1"></i> Add Question
        </a>
    </div>

    @if (TempData["Success"] != null)
    {
        <div class="alert alert-success alert-dismissible fade show">
            @TempData["Success"]
            <button type="button" class="btn-close" data-bs-dismiss="alert"></button>
        </div>
    }

    <div class="card border-0 shadow-sm mb-4">
        <div class="card-body">
            <form asp-action="Index" method="get">
                <div class="row g-3">
                    <div class="col-md-4">
                        <label class="form-label fw-semibold">Search</label>
                        <input type="text" name="search"
                               value="@ViewBag.Search"
                               class="form-control"
                               placeholder="Search question or topic..." />
                    </div>

                    <div class="col-md-3">
                        <label class="form-label fw-semibold">Subject</label>
                        <select name="subjectId" class="form-select"
                                asp-items="subjects">
                            <option value="">All subjects</option>
                        </select>
                    </div>

                    <div class="col-md-3">
                        <label class="form-label fw-semibold">Difficulty</label>
                        <select name="difficulty" class="form-select">
                            <option value="">All difficulties</option>
                            <option value="Easy" selected="@(ViewBag.Difficulty as string == "Easy")">Easy</option>
                            <option value="Medium" selected="@(ViewBag.Difficulty as string == "Medium")">Medium</option>
                            <option value="Hard" selected="@(ViewBag.Difficulty as string == "Hard")">Hard</option>
                        </select>
                    </div>

                    <div class="col-md-2 d-flex align-items-end gap-2">
                        <button type="submit" class="btn btn-primary flex-grow-1">
                            <i class="bi bi-search"></i> Search
                        </button>
                        <a asp-action="Index" class="btn btn-outline-secondary">
                            <i class="bi bi-arrow-clockwise"></i>
                        </a>
                    </div>
                </div>
            </form>
        </div>
    </div>

    <div class="card border-0 shadow-sm">
        <div class="card-header bg-white py-3">
            <div class="d-flex justify-content-between align-items-center">
                <h5 class="fw-bold mb-0">Question List</h5>
                <span class="badge bg-primary">
                    @Model.Count() Questions
                </span>
            </div>
        </div>

        <div class="card-body p-0">
            <div class="table-responsive">
                <table class="table table-hover align-middle mb-0">
                    <thead class="table-light">
                        <tr>
                            <th class="ps-3">#</th>
                            <th>Question</th>
                            <th>Subject</th>
                            <th>Topic</th>
                            <th>Difficulty</th>
                            <th>Options</th>
                            <th>Status</th>
                            <th class="text-center">Actions</th>
                        </tr>
                    </thead>
                    <tbody>
                        @if (!Model.Any())
                        {
                            <tr>
                                <td colspan="8" class="text-center py-5 text-muted">
                                    <i class="bi bi-inbox fs-1 d-block mb-2"></i>
                                    No questions found.
                                </td>
                            </tr>
                        }
                        else
                        {
                            var index = 0;
                            foreach (var question in Model)
                            {
                                index++;

                                <tr>
                                    <td class="ps-3">@index</td>
                                    <td style="min-width:250px; max-width:350px;">
                                        <div class="fw-semibold text-break">
                                            @question.Content
                                        </div>
                                    </td>
                                    <td>
                                        <span class="badge bg-light text-dark border">
                                            @question.Subject?.Name
                                        </span>
                                    </td>
                                    <td>@(question.Topic ?? "-")</td>
                                    <td>
                                        @if (question.Difficulty == "Easy")
                                        {
                                            <span class="badge bg-success">Easy</span>
                                        }
                                        else if (question.Difficulty == "Medium")
                                        {
                                            <span class="badge bg-warning text-dark">Medium</span>
                                        }
                                        else
                                        {
                                            <span class="badge bg-danger">Hard</span>
                                        }
                                    </td>
                                    <td>@question.Options.Count</td>
                                    <td>
                                        @if (question.IsActive)
                                        {
                                            <span class="badge bg-success">Active</span>
                                        }
                                        else
                                        {
                                            <span class="badge bg-secondary">Inactive</span>
                                        }
                                    </td>
                                    <td class="text-center text-nowrap">
                                        <a asp-action="Edit"
                                           asp-route-id="@question.Id"
                                           class="btn btn-sm btn-outline-primary"
                                           title="Edit">
                                            <i class="bi bi-pencil-square"></i>
                                        </a>

                                        @if (question.IsActive)
                                        {
                                            <a asp-action="Delete"
                                               asp-route-id="@question.Id"
                                               class="btn btn-sm btn-outline-danger"
                                               title="Delete">
                                                <i class="bi bi-trash"></i>
                                            </a>
                                        }
                                    </td>
                                </tr>
                            }
                        }
                    </tbody>
                </table>
            </div>
        </div>
    </div>
</div>
